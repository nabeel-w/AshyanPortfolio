# Copy to .env.local (Next.js) and .env (Prisma CLI) — never commit real values.
# Validated at boot by src/lib/env.ts

# ── Database · Neon ────────────────────────────────────────────
# Pooled connection (host contains "-pooler") — used by the app at runtime
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/ashyan?sslmode=require"
# Direct connection (no "-pooler") — used by `prisma migrate`
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/ashyan?sslmode=require"

# ── Auth · Better Auth ─────────────────────────────────────────
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-32+-random-characters"
BETTER_AUTH_URL="http://localhost:3000"
# Only these emails can create an account (comma separated)
ADMIN_EMAILS="admin@example.com"

# ── Site ───────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Analytics ──────────────────────────────────────────────────
# Salt for cookieless visitor hashing. Generate: openssl rand -hex 16
ANALYTICS_SALT="replace-with-random-hex"

# ── Asset storage ──────────────────────────────────────────────
# Pick a provider per media type, then fill ONLY that provider's block below.
# Leave all empty in development to use "local" (files go to public/uploads).
# Check your setup any time with:  pnpm media:check
# Providers: local | s3 | vercel-blob | mux | cloudflare-stream   (docs/03-asset-storage.md)
MEDIA_VIDEO_PROVIDER=""       # recommended: mux
MEDIA_IMAGE_PROVIDER=""       # recommended: vercel-blob (on Vercel) or s3 (Cloudflare R2)
MEDIA_FILE_PROVIDER=""        # PDFs/audio — defaults to MEDIA_IMAGE_PROVIDER
# Optional per-kind upload limits in MB (defaults: image 50, video 10000, audio 500, document 50)
# MEDIA_MAX_VIDEO_MB=10000

# mux — https://dashboard.mux.com → Settings → Access Tokens
MUX_TOKEN_ID=""
MUX_TOKEN_SECRET=""
MUX_WEBHOOK_SECRET=""         # webhook URL: <site>/api/media/webhooks/mux
MUX_VIDEO_QUALITY="basic"     # basic (free encoding) | plus | premium

# cloudflare-stream — dashboard → Stream
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_STREAM_API_TOKEN=""          # token with Stream:Edit
CLOUDFLARE_STREAM_CUSTOMER_CODE=""      # from customer-<code>.cloudflarestream.com
CLOUDFLARE_STREAM_WEBHOOK_SECRET=""     # webhook URL: <site>/api/media/webhooks/cloudflare-stream

# vercel-blob — Vercel dashboard → Storage → Blob (public store)
BLOB_READ_WRITE_TOKEN=""

# s3 — any S3-compatible store. Cloudflare R2 example:
S3_ENDPOINT=""                # https://<account_id>.r2.cloudflarestorage.com
S3_REGION="auto"              # R2: auto · AWS: e.g. ap-south-1
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""              # public base, e.g. https://media.ashyanzafar.com
# S3_FORCE_PATH_STYLE="true"  # set "false" for virtual-hosted AWS buckets
