# Copy to .env.local (Next.js) and .env (Prisma CLI) — never commit real values.
# Validated at boot by src/lib/env.ts

# ── Database · Neon ────────────────────────────────────────────
# Pooled connection (host contains "-pooler") — used by the app at runtime
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/ashyan?sslmode=require"
# Direct connection (no "-pooler") — used by `prisma migrate`
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/ashyan?sslmode=require"

# ── Auth · Better Auth ─────────────────────────────────────────
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-32+-random-characters"
BETTER_AUTH_URL="http://localhost:3000"
# Only these emails can create an account (comma separated)
ADMIN_EMAILS="admin@example.com"

# ── Site ───────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Analytics ──────────────────────────────────────────────────
# Salt for cookieless visitor hashing. Generate: openssl rand -hex 16
ANALYTICS_SALT="replace-with-random-hex"

# ── Asset storage (fill the provider you choose — docs/03-asset-storage.md) ──
# Video · Mux (recommended)
MUX_TOKEN_ID=""
MUX_TOKEN_SECRET=""
MUX_WEBHOOK_SECRET=""

# Images · Vercel Blob
BLOB_READ_WRITE_TOKEN=""

# Images/files · Cloudflare R2 (alternative to Blob)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL=""
